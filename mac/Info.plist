<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>${EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>com.wifidebughelper.app</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>${QMAKE_PKGINFO_TYPEINFO}</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleAllowMixedLocalizations</key>
    <true/>
    <key>CFBundleName</key>
    <string>WiFi 无线调试助手</string>
    <key>CFBundleDisplayName</key>
    <string>WiFi 无线调试助手</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>${MACOSX_DEPLOYMENT_TARGET}</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <!-- 读取当前 WiFi 的 SSID 在新版 macOS 上属于「定位」权限范畴，
         系统弹授权框时需要这段说明文字。 -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>用于读取当前连接的 WiFi 名称，生成让手机一键入网的二维码。</string>
    <!-- macOS 15 起访问局域网设备要单独授权：UDP 扫描鸿蒙设备、
         连接手机上的 adb/hdc 端口都会触发这个提示。 -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>用于在局域网内发现并连接开启了无线调试的 Android / 鸿蒙设备。</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_adb-tls-pairing._tcp</string>
        <string>_adb-tls-connect._tcp</string>
    </array>
</dict>
</plist>
